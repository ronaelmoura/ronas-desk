# Ronas Desk — configuração local
# Copie este arquivo para .env e preencha somente as credenciais necessárias.

# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ronas_desk
DB_USER=root
DB_PASSWORD=troque_por_uma_senha_forte

# SSL do banco (necessário para Aiven em produção)
DB_SSL=false
DB_SSL_CA_BASE64=

# Autenticação
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
JWT_EXPIRES_IN=8h

# Anexos (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Assistente de chamados (Gemini, opcional)
GEMINI_API_KEY=

# Segurança e limites de requisições (opcionais; estes são os valores padrão)
TRUST_PROXY_HOPS=1
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
IA_RATE_LIMIT_WINDOW_MS=900000
IA_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Caminho alternativo para o frontend compilado (opcional)
FRONTEND_DIST_PATH=

# Scripts administrativos (opcionais; não use senhas reais neste arquivo)
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_CARGO=Administrador
DEMO_NOME=Visitante Demo
DEMO_EMAIL=
